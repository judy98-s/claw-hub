# ── 필수 ─────────────────────────────────────────────────────────────
# 하나라도 비어 있으면 서버는 기동을 거부한다.

DATABASE_URL=postgres://clawhub:clawhub@localhost:5432/clawhub?sslmode=disable

# 32바이트 base64 키 3종. 아래 명령으로 생성한다:
#   openssl rand -base64 32
# 또는 한 번에:  make keys
DATA_ENCRYPTION_KEY=
HASH_PEPPER=
SESSION_SECRET=

# ── 선택 ─────────────────────────────────────────────────────────────

ADDR=:8080

# 비우면 인메모리 캐시를 쓴다. Redis 없이도 단일 인스턴스로 동작한다.
# Valkey / ElastiCache 로 바꿀 때도 이 주소만 교체하면 된다.
REDIS_URL=

# 비우면 알림이 비활성화된다. 대시보드는 그대로 동작한다.
SLACK_WEBHOOK_URL=

MEDIA_DIR=./data/photos

# QR 코드에 인코딩될 주소. 손님이 스캔하면 {PUBLIC_BASE_URL}/r/{code} 로 간다.
PUBLIC_BASE_URL=http://localhost:3000

# 송금 딥링크 템플릿.
#
# 치환 토큰:
#   {bankShort}  토스가 받는 짧은 은행명 ("국민", "카카오")
#   {bankName}   정식 명칭 ("국민은행")
#   {bank}       금융결제원 기관코드 ("004")
#   {account}    계좌번호 (숫자만)
#   {amount}     금액
#   {holder}     예금주
#
# 토스 예시 (bank 에는 반드시 {bankShort} 를 쓴다 — 코드나 정식명은 인식하지 못한다):
#   PAYOUT_DEEPLINK_TEMPLATES={"toss":"supertoss://send?bank={bankShort}&accountNo={account}&amount={amount}"}
#
# 이 스킴은 토스가 공식 문서로 제공하는 규격이 아니라 커뮤니티가 관찰해
# 정리한 값이다. 예고 없이 바뀔 수 있어서 코드가 아니라 설정으로 뒀다.
# 비워두면 UI가 "계좌 복사 + 수동 송금 완료" 경로만 보여준다.
PAYOUT_DEEPLINK_TEMPLATES={}

# ── 정책 (현장 데이터가 쌓이면 조정) ──────────────────────────────────

# 이 금액 이상이면 사진 필수 + 수동 검토 + 통화 버튼
POLICY_REVIEW_THRESHOLD_KRW=10000
# 30일 내 같은 번호의 신고 횟수 임계치
POLICY_REPEAT_WATCH_COUNT=3
POLICY_REPEAT_HOLD_COUNT=5
# 한 계좌에 연결된 서로 다른 번호가 이 수 이상이면 검토
POLICY_ACCOUNT_SHARING_PHONES=3
# 30일 누적 지급액이 이 금액을 넘으면 검토
POLICY_PAYOUT_CEILING_KRW=50000
# 이 금액을 넘는 신고는 접수 자체를 거부
POLICY_MAX_AMOUNT_KRW=1000000
# 24시간 내 한 기계에 이 건수 이상이면 점검 알림
POLICY_MACHINE_ALERT_COUNT=3

PHOTO_RETENTION_DAYS=90
