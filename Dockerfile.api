# syntax=docker/dockerfile:1
FROM golang:1.24-alpine AS build
WORKDIR /src

# 의존성을 먼저 받아 레이어 캐시를 살린다.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO 없이 정적 링크해야 distroless 에서 뜬다.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api  ./cmd/api  && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/setup  ./cmd/setup

# 사진 디렉터리를 이미지 안에 미리 만들어 둔다.
#
# 도커는 비어 있는 이름 있는 볼륨을 마운트할 때, 이미지의 그 경로에 있는
# 내용으로 볼륨을 초기화하고 **소유권까지 가져간다.** 이 디렉터리가
# 이미지에 없으면 볼륨이 root:root 0755 로 만들어지고, nonroot 로 도는
# 프로세스가 그 안에 mkdir 을 못 한다:
#
#   저장 디렉터리 생성: mkdir /data/photos: permission denied
RUN mkdir -p /data/photos

# distroless: 셸도 패키지 매니저도 없다. 침입해도 쓸 도구가 없다.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /out/worker /out/setup /

# 65532 는 distroless nonroot 의 uid 다. 이름 대신 숫자를 쓰는 이유는
# COPY --chown 이 대상 이미지의 /etc/passwd 를 봐야 하기 때문이다.
#
# VOLUME 보다 **먼저** 와야 한다. VOLUME 뒤에 그 경로로 추가한 내용은
# 이미지에 남지 않는다.
COPY --from=build --chown=65532:65532 /data /data

# 사진이 쌓이는 곳. compose 에서 볼륨을 붙인다.
VOLUME ["/data"]
USER nonroot:nonroot
ENTRYPOINT ["/api"]
